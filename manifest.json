{
  "manifest_version": 3,
  "name": "Courtside – Live Scores Overlay",
  "short_name": "Courtside",
  "version": "1.0.0",
  "description": "Live scores, box scores and player stats for the NFL, NBA, MLB, NHL and college football, in a pop-up that floats over the game you're watching.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Courtside live scores",
    "default_popup": "src/app/app.html?mode=popup",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://site.api.espn.com/*"
  ],
  "commands": {
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Show or hide the score overlay on the current page"
    },
    "open-popout": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open scores in a floating pop-out window"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/app/app.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
